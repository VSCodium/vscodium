{
  "name": "cursor-ing-artifacts",
  "displayName": "Cursor ING Artifacts",
  "description": "Sandboxed artifact preview for generated HTML prototypes, dashboards, and design artifacts.",
  "version": "0.1.3",
  "license": "MIT",
  "publisher": "cursor-ing",
  "engines": { "vscode": "^1.85.0" },
  "activationEvents": ["onCommand:cursorIng.openArtifactPreview"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "cursorIng.openArtifactPreview", "title": "Cursor ING: Open Artifact Preview" }
    ]
  },
  "scripts": { "compile": "tsc -p ./", "watch": "tsc -watch -p ./" },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
