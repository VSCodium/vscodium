From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Baptiste Augrain <daiyam@zokugun.org>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: use @vscodium/native-keymap fork instead of upstream native-keymap

Swaps the upstream native-keymap dependency for VSCodium's @vscodium/native-keymap fork and sets build_from_source_native_keymap="no" so the vendored prebuilt binary is used as-is; the moduleignore keeps only the fork's build/Release/*.node while dropping its source and build trees.

diff --git a/.npmrc b/.npmrc
index c28bfd82d97fe4c221453b5b98fdd09dd3fa826c..6f4c24af7ac30c88e6c9aba6346efe4a3e0845c0 100644
--- a/.npmrc
+++ b/.npmrc
@@ -4,5 +4,6 @@ ms_build_id="14906494"
 runtime="electron"
 ignore-scripts=false
 build_from_source="true"
+build_from_source_native_keymap="no"
 legacy-peer-deps="true"
 timeout=180000
