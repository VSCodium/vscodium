From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Baptiste Augrain <daiyam@zokugun.org>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: use @vscodium/native-keymap fork instead of upstream native-keymap

Swaps the upstream native-keymap dependency for VSCodium's @vscodium/native-keymap fork and sets build_from_source_native_keymap="no" so the vendored prebuilt binary is used as-is; the moduleignore keeps only the fork's build/Release/*.node while dropping its source and build trees.

diff --git a/.npmrc b/.npmrc
index 02f65e85e66051819036a01933298426a04958ae..e2530b3a57f36ff86fc382af83d0804d56148085 100644
--- a/.npmrc
+++ b/.npmrc
@@ -4,5 +4,6 @@ ms_build_id="14760073"
 runtime="electron"
 ignore-scripts=false
 build_from_source="true"
+build_from_source_native_keymap="no"
 legacy-peer-deps="true"
 timeout=180000
diff --git a/build/.moduleignore b/build/.moduleignore
index 6149b1ace972c05d0576ebbdaddaf1888886e271..61ecce881a08b66bd81e7ffb9edc0797facd9a41 100644
--- a/build/.moduleignore
+++ b/build/.moduleignore
@@ -67,11 +67,11 @@ fsevents/test/**
 !@vscode/tree-sitter-wasm/wasm/tree-sitter-powershell.wasm
 !@vscode/tree-sitter-wasm/wasm/tree-sitter-bash.wasm
 
-native-keymap/binding.gyp
-native-keymap/build/**
-native-keymap/src/**
-native-keymap/deps/**
-!native-keymap/build/Release/*.node
+@vscodium/native-keymap/binding.gyp
+@vscodium/native-keymap/build/**
+@vscodium/native-keymap/src/**
+@vscodium/native-keymap/deps/**
+!@vscodium/native-keymap/build/Release/*.node
 
 native-is-elevated/binding.gyp
 native-is-elevated/build/**
