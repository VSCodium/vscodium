From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Baptiste Augrain <daiyam@zokugun.org>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: guard original-fs module hook behind module.register availability for
 reh
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The fs→original-fs module-resolution hook is only needed under Electron; the REH server runs on a plain Node.js runtime that may lack `module.register`, where installing the hook is unnecessary and breaks the bootstrap. Skip `enableASARSupport` unless `Module.register` is available (#2050).

diff --git a/src/bootstrap-esm.ts b/src/bootstrap-esm.ts
index 49098a3132c24ad03a1c996519033403112d2a17..ae041b7dfffffeec75d034ad4f9821df1c345e94 100644
--- a/src/bootstrap-esm.ts
+++ b/src/bootstrap-esm.ts
@@ -4,7 +4,7 @@
  *--------------------------------------------------------------------------------------------*/
 
 import * as fs from 'node:fs';
-import { register } from 'node:module';
+import * as Module from 'node:module';
 import { dirname, join } from 'node:path';
 import { product, pkg } from './bootstrap-meta.js';
 import './bootstrap-node.js';
@@ -38,7 +38,7 @@ globalThis._VSCODE_FILE_ROOT = import.meta.dirname;
 // `node_modules` — exactly as it would without the archive. Only when the
 // default resolution finds nothing do we consult the archive.
 function enableASARSupport(): void {
-	if (!process.env['ELECTRON_RUN_AS_NODE'] && !process.versions['electron']) {
+	if (Module.register as unknown && (process.env['ELECTRON_RUN_AS_NODE'] || process.versions['electron'])) {
 		return; // only on Electron / Electron-as-node
 	}
 
@@ -233,7 +233,7 @@ function enableASARSupport(): void {
 	// Unlike process.resourcesPath, import.meta.dirname reflects Node's junction-resolved module path.
 	const appRoot = dirname(import.meta.dirname);
 
-	register(`data:text/javascript;base64,${Buffer.from(jsCode).toString('base64')}`, import.meta.url, {
+	Module.register(`data:text/javascript;base64,${Buffer.from(jsCode).toString('base64')}`, import.meta.url, {
 		data: process.env['VSCODE_DEV'] ? {} : {
 			resourcesPath: appRoot,
 			asarPath: join(appRoot, 'node_modules.asar'),
