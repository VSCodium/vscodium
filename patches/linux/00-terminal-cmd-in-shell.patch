Subject: run linux external terminal exec through a shell to allow
 space-separated args
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Passes `shell: true` to the spawn call in `LinuxExternalTerminalService` so the `terminal.external.linuxExec` setting is interpreted by a shell instead of being treated as a single executable path. This lets the command carry space-separated arguments — for example wrapping it in `flatpak-spawn` or appending options — without resorting to a separate wrapper script (#2790).

diff --git a/src/vs/platform/externalTerminal/node/externalTerminalService.ts b/src/vs/platform/externalTerminal/node/externalTerminalService.ts
index 4424cc7f11bf4564de977db062abe47a32058f94..fad0df4718a9cf523f14bc4b938981af2e86383f 100644
--- a/src/vs/platform/externalTerminal/node/externalTerminalService.ts
+++ b/src/vs/platform/externalTerminal/node/externalTerminalService.ts
@@ -327,7 +327,7 @@ export class LinuxExternalTerminalService extends ExternalTerminalService implem
 				const env = getSanitizedEnvironment(process);
 				const basename = path.basename(exec).toLowerCase();
 				const args = basename === 'ghostty' && cwd ? [`--working-directory=${cwd}`] : [];
-				const child = spawner.spawn(exec, args, { cwd, env });
+				const child = spawner.spawn(exec, args, { cwd, env, shell: true });
 				child.on('error', e);
 				child.on('exit', () => c());
 			});
