From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alex Garcia <lex@ibm.com>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: register qemu emulation via tonistiigi/binfmt for cross-arch reh
 builds

Cross-compiling the remote server runs npm inside a foreign-arch container, so qemu binfmt handlers must be registered on the host beforehand. Switching from multiarch/qemu-user-static to tonistiigi/binfmt fixed ppc64le segfaults during REH builds (#2264); a shared emulateArchList (arm64, arm, ppc64, riscv64, s390x, loong64) then drove every emulated target, gated by a DISABLE_QEMU opt-out (#2549).

Co-authored-by: darkyzhou <7220778+darkyzhou@users.noreply.github.com>
Co-authored-by: Andreas Grapentin <andreas.grapentin@ibm.com>
Co-authored-by: Levi Zim <rsworktech@outlook.com>
Co-authored-by: Baptiste Augrain <daiyam@zokugun.org>

diff --git a/build/npm/postinstall.ts b/build/npm/postinstall.ts
index 5d270d307ffd5e8102820bed7ee374197b66474b..e6066204a552c25963fa81c6d5d3c0056c5617a9 100644
--- a/build/npm/postinstall.ts
+++ b/build/npm/postinstall.ts
@@ -72,9 +72,11 @@ async function npmInstallAsync(dir: string, opts?: child_process.SpawnOptions):
 		const userinfo = os.userInfo();
 		log(dir, `Installing dependencies inside container ${process.env['VSCODE_REMOTE_DEPENDENCIES_CONTAINER_NAME']}...`);
 
-		if (process.env['npm_config_arch'] === 'arm64') {
-			run('sudo', ['docker', 'run', '--rm', '--privileged', 'vscodehub.azurecr.io/multiarch/qemu-user-static@sha256:fe60359c92e86a43cc87b3d906006245f77bfc0565676b80004cc666e4feb9f0', '--reset', '-p', 'yes'], syncOpts);
-		}
+		const emulateArchList = ['arm64', 'arm', 'ppc64', 'riscv64', 's390x', 'loong64'];
+		if (process.env['DISABLE_QEMU'] !== 'true' && !!process.env['npm_config_arch'] && emulateArchList.includes(process.env['npm_config_arch'])) {
+			run('sudo', ['docker', 'run', '--rm', '--privileged', 'tonistiigi/binfmt:latest', '--install', 'all'], syncOpts);
+ 		}
+
 		run('sudo', [
 			'docker', 'run',
 			'-e', 'GITHUB_TOKEN',
