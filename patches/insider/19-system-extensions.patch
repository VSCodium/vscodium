From: Baptiste Augrain <daiyam@zokugun.org>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: gate system extension updates on the built-in allowlist in insider
 builds

Upstream only blocks updates to system (built-in) extensions in stable-quality builds; dropping the `quality === 'stable'` guard applies the same restriction to insider builds, so bundled extensions update only when listed in `builtInExtensionsEnabledWithAutoUpdates`.

diff --git a/src/vs/workbench/contrib/extensions/browser/extensionsWorkbenchService.ts b/src/vs/workbench/contrib/extensions/browser/extensionsWorkbenchService.ts
index 1281dc0c2a3bb485429c01caf0e6847abe2bcd8b..ef1a142906306a74966f84140a8d74c74b8ec02c 100644
--- a/src/vs/workbench/contrib/extensions/browser/extensionsWorkbenchService.ts
+++ b/src/vs/workbench/contrib/extensions/browser/extensionsWorkbenchService.ts
@@ -111,6 +111,7 @@ export class Extension implements IExtension {
 		@ITelemetryService private readonly telemetryService: ITelemetryService,
 		@ILogService private readonly logService: ILogService,
 		@IFileService private readonly fileService: IFileService,
+		// @ts-ignore
 		@IProductService private readonly productService: IProductService,
 		@IConfigurationService protected configurationService: IConfigurationService
 	) {
@@ -341,7 +342,7 @@ export class Extension implements IExtension {
 				return false;
 			}
 			// Do not allow updating system extensions in stable
-			if (this.type === ExtensionType.System && this.productService.quality === 'stable' && !this.productService.builtInExtensionsEnabledWithAutoUpdates?.some(id => id.toLowerCase() === this.identifier.id.toLowerCase())) {
+			if (this.type === ExtensionType.System && !this.productService.builtInExtensionsEnabledWithAutoUpdates?.some(id => id.toLowerCase() === this.identifier.id.toLowerCase())) {
 				return false;
 			}
 			if (!this.local.preRelease && this.gallery.properties.isPreReleaseVersion) {
