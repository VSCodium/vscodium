From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Baptiste Augrain <daiyam@zokugun.org>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: add reh server download url template to product.json

Stamps `serverDownloadUrlTemplate` into product.json when packaging so remote/SSH/tunnel clients auto-fetch the matching remote-extension-host archive from the project's own GitHub release assets instead of Microsoft's servers (#1392). The URL uses build-time placeholders (`!!ASSETS_REPOSITORY!!`, `!!RELEASE_VERSION!!`, `!!APP_NAME_LC!!`) that are materialized to concrete branding.

diff --git a/build/gulpfile.reh.ts b/build/gulpfile.reh.ts
index 3620dd07d8b6ea8867dd923df40ae731344032ca..132ab244608aba772fb65a8c1b8bee79ba25afd1 100644
--- a/build/gulpfile.reh.ts
+++ b/build/gulpfile.reh.ts
@@ -411,6 +411,7 @@ function packageTask(type: string, platform: string, arch: string, sourceFolderN
 		let productJsonContents = '';
 		const productJsonStream = gulp.src(['product.json'], { base: '.' })
 			.pipe(jsonEditor((json: Record<string, unknown>) => {
+				json.serverDownloadUrlTemplate = 'https://github.com/!!ASSETS_REPOSITORY!!/releases/download/!!RELEASE_VERSION!!/!!APP_NAME_LC!!-reh-${os}-${arch}-!!RELEASE_VERSION!!.tar.gz';
 				json.commit = commit;
 				json.date = readISODate(sourceFolderName);
 				json.version = version;
