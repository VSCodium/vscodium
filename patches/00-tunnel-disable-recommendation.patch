From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Baptiste Augrain <daiyam@zokugun.org>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: skip tunnel extension recommendation when no remote extension is
 configured

Guard `shouldRecommend` to bail out early when `serverConfiguration.extension` is unset. VSCodium's product configuration ships no remote tunnel extension, so without this check the workbench would prompt users to install an extension that does not exist.

diff --git a/src/vs/workbench/contrib/remoteTunnel/electron-browser/remoteTunnel.contribution.ts b/src/vs/workbench/contrib/remoteTunnel/electron-browser/remoteTunnel.contribution.ts
index 5d9e7c58d8fe548a8edb2d4319ff8d6a208f94c2..584e9e42dcaa82dfd09985f6d03e212d3693ba83 100644
--- a/src/vs/workbench/contrib/remoteTunnel/electron-browser/remoteTunnel.contribution.ts
+++ b/src/vs/workbench/contrib/remoteTunnel/electron-browser/remoteTunnel.contribution.ts
@@ -155,6 +155,9 @@ export class RemoteTunnelWorkbenchContribution extends Disposable implements IWo
 
 		const remoteExtension = this.serverConfiguration.extension;
 		const shouldRecommend = async () => {
+			if (!Boolean(remoteExtension)) {
+				return false;
+			}
 			if (this.storageService.getBoolean(REMOTE_TUNNEL_EXTENSION_RECOMMENDED_KEY, StorageScope.APPLICATION)) {
 				return false;
 			}
